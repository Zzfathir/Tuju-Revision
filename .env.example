# Map tiles (demo-scale OSM by default; swap for a keyed provider at scale)
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional: only used by offline scripts (build-route, build-eta-grid). Never exposed to the client.
GOOGLE_MAPS_API_KEY=
# Protects /stats
STATS_KEY=change-me
